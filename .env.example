# ============================================================================
# Agent Studio & Cowork Web IDE — Example Environment Configuration
# Copy this file to .env:   cp .env.example .env
# ============================================================================

# Server Binding
# - Use 127.0.0.1 for local machine / Termux on Android
# - Use 0.0.0.0 if you want to open the IDE on your Android phone over local Wi-Fi
PORT=3300
HOST=127.0.0.1

# Primary Provider Key (Agent Router)
AGENTROUTER_API_KEY=sk-your-agentrouter-key-here

# Optional Additional Provider Keys (Can also be set inside the Agent Studio UI -> Providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
